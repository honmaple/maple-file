                "sourceConfig": {
                  "type": "string",
                  "title": "JSON object. Album uses {\"album_ids\":[...]}; local_directory uses\n{\"path\":\"/absolute/path\",\"bookmark\":\"...\"}.\n@gotags: gorm:\"not null\""
